{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://sdm-dashboard.taila29011.ts.net/api/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://sdm-dashboard.taila29011.ts.net/media/$1"
    },
    {
      "source": "/((?!api/|media/).*)",
      "destination": "/index.html"
    }
  ]
}
